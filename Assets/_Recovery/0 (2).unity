--- !u!114 &129308703
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 129308701}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"I was born from a drop of sun,yet raised in shadow, never free.\r\nShe
    stole my gift when day was done, and kept my power all for she.\r\n\r\nPush aside
    where I would dream,\r\n(The only rest I ever knew).\r\nThree treasures wait
    below the seam \u2014\r\nThe flower that bloomed the day I flew,\r\nThe tales
    I read to pass the years,\r\nThe brush that tamed my golden fears.\r\n\r\nNow
    turn them as my heart would ache:\r\nThe bloom leans toward the dawn's first
    break,\r\nThe stories reach for skies above,\r\nThe brush points where I dreamt
    of love.\r\n\r\nPlace them where the moonlight falls,\r\nAnd watch her kingdom
    crack its walls.\"\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
