  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"I was born from a drop of sun,yet raised in shadow, never free.\r\nShe
    stole my gift when day was done, and kept my power all for she.\r\n\r\nPush aside
    where I would dream, three treasures wait below the seam \u2014\r\nThe flower
    that bloomed the day I flew,\r\nThe tales I read to pass the years,\r\nThe brush
    that tamed my golden fears.\r\n\r\nNow turn them as my heart would ache \u2014\r\nThe
    bloom leans toward the dawn's first break,\r\nThe stories reach for skies above,\r\nThe
    brush points where I dreamt of love.\r\n\r\nPlace them where the moonlight falls,
    and watch her kingdom crack its walls.\"\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d36f1bc3c0633bd41ac2f044ec834d59, type: 2}
