  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "You are trapped inside Xiao Ming\u2019s room.\n\nXiao Ming is obsessed
    with creating dolls.\nHis craftsmanship is so extraordinary that every doll carries
    its own unique scent.\n\nAmong all of his creations, there is one he treasures
    above all else \u2014\na doll that carries the same scent as \u201CXiao Mei.\u201D\n\nHowever,
    Xiao Ming suffers from severe memory loss.\nEvery morning when he wakes up, he
    forgets the password to his own home.\n\nTo prevent himself from forgetting again,
    he hid the password across the doll\u2019s head, torso, and limbs, scattering
    the parts throughout the room.\n\nOnly by finding every piece of his most beloved
    doll can the true password be revealed."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
